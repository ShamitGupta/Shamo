# Build context is the repository root (see deploy/Dockerfile). Only
# backend_v2/app and backend_v2/requirements.txt are actually needed, so
# everything else is excluded -- this keeps the context from shipping the
# ~180MB of node_modules, fixtures and PDFs across the wire on every build.

.git
.venv
**/__pycache__
**/*.pyc
.pytest_cache

# Secrets must never enter an image layer.
**/.env
**/.env.*
!**/.env.example

frontend/
workflows/
database/
# Capital B: the tracked directory is "Backend/". A lowercase pattern matches
# it on Windows/macOS but NOT in a Linux build, so the superseded prototype
# was reaching the build context on exactly the builds that matter.
Backend/
archive/
tmp/
docs/
*.md
!backend_v2/README.md

.claude
.agents
.mcp.json
