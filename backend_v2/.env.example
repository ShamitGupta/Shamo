# Copy to backend_v2/.env and fill in. Never commit the filled copy.

# Supabase project URL, e.g. https://<project>.supabase.co
SUPABASE_URL=

# SERVICE ROLE key, not the anon key. The normalized shamo_* tables have RLS on
# with no anon policies, so the anon key returns nothing. This key must never
# reach the browser -- that is the whole reason this service sits in between.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# Shared secret a teacher types at /teacher to claim a staff role. Leaving this
# unset is the SAFE state: with no code configured, nobody can claim staff
# access at all. Set it to a long random string and hand it out by hand.
# A staff account can read every student's practice activity and attempts, so
# treat this exactly like a credential.
SHAMO_TEACHER_INVITE_CODE=

# Optional overrides
# SHAMO_TUTOR_MODEL=gpt-5.4-mini
# SHAMO_ALLOWED_ORIGINS=http://localhost:5173
# SHAMO_ASSET_URL_TTL=600
