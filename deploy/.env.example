# Copy to deploy/.env ON THE SERVER and fill in. Never commit the real file.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# One file for the whole stack. docker compose reads it for the site address and
# the frontend build, and passes it to the API container as its environment.

# ---- where the app is served ------------------------------------------------
# The hostname this server answers to. Caddy gets an HTTPS certificate for it
# automatically. Either the static IP with dots, followed by .sslip.io (works
# with no DNS set up at all), or a name you have pointed at the static IP:
#   SITE_ADDRESS=13.250.10.20.sslip.io
#   SITE_ADDRESS=demo.shamoclasses.com
SITE_ADDRESS=

# ---- secret: the API only ---------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key, not the anon/publishable key. The normalized shamo_* tables
# have RLS enabled with no anon policies, so the anon key returns nothing. This
# key bypasses RLS entirely -- it is the single most sensitive value on the box.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# Anyone holding this can become a teacher and read every student's progress.
# Leave it blank to make teacher signup impossible.
SHAMO_TEACHER_INVITE_CODE=

# ---- public: baked into the frontend JavaScript -----------------------------
# Readable by anyone who opens the site, by design. Same values as frontend/.env.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_DESMOS_API_KEY=
