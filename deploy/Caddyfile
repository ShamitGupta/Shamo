# The single front door for the whole app: serves the React build and proxies
# /api to the tutor API container.
#
# SITE_ADDRESS comes from deploy/.env. Give it a hostname -- 1.2.3.4.sslip.io or
# demo.shamoclasses.com -- and Caddy obtains and renews a Let's Encrypt
# certificate on its own. The only prerequisites are that the name already
# resolves to this server and that ports 80 AND 443 are open. Port 80 must stay
# open even though everything ends up on HTTPS: the certificate challenge uses
# it, and a closed port 80 is the usual cause of "certificate could not be
# obtained". For a plain-HTTP local test, set SITE_ADDRESS=http://localhost.

{$SITE_ADDRESS} {
	encode gzip

	# The browser calls /api/papers; the API itself serves /papers. handle_path
	# strips the prefix before forwarding.
	handle_path /api/* {
		# POST /chat streams tokens as they are generated. Caddy does not buffer
		# proxied responses by default, but stating flush_interval explicitly
		# means a later config change cannot silently reintroduce buffering and
		# turn the streamed reply into one delayed block of text.
		reverse_proxy api:8000 {
			flush_interval -1

			# A Manim render is a synchronous 35-60s request and manim_renderer
			# caps its own subprocess at 60s. 180s leaves room for the render
			# plus the model call ahead of it without ever being what fails.
			transport http {
				response_header_timeout 180s
				read_timeout 180s
			}
		}
	}

	# Vite fingerprints everything under /assets with a content hash, so a change
	# produces a new filename -- safe to cache for a year. A MISSING asset is a
	# plain 404, never the app page: a browser holding an old index.html asks for
	# last deploy's filenames, and caching HTML under a .js name for a year would
	# break that browser until someone cleared it.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv

		# Everything else is index.html (by name or via the fallback below),
		# which changes on every deploy; caching it would pin browsers to the
		# old bundle.
		header Cache-Control "no-cache"

		# /dashboard and /teacher are client-side routes, not files. Without
		# this fallback a refresh or a shared link on one of them is a 404.
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
