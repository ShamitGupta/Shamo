# Copy to deploy/api.env ON THE SERVER and fill in. Never commit the real file.
#   cp deploy/api.env.example deploy/api.env && chmod 600 deploy/api.env

SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key, not the anon/publishable key. The normalized shamo_* tables
# have RLS enabled with no anon policies, so the anon key returns nothing. This
# key bypasses RLS entirely -- it is the single most sensitive value on the box.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# Must list the exact scheme + host the browser sends. A trailing slash, a
# missing "https://", or the www variant left out will all surface as an opaque
# CORS failure in the browser rather than a server-side error.
SHAMO_ALLOWED_ORIGINS=https://shamoclasses.com,https://www.shamoclasses.com

SHAMO_TUTOR_MODEL=gpt-5.4-mini
SHAMO_GENERATED_MEDIA_BUCKET=shamo-generated-media
