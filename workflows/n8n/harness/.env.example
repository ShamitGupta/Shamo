# Copy to .env (gitignored) and fill in.
#
# SUPABASE_URL is the same project URL already used by backend/.env.
# SUPABASE_SERVICE_ROLE_KEY is required because every shamo_* table has RLS
# enabled with no anon/authenticated policies -- the anon key returns 401 on
# shamo_ingestion_pages. Get it from:
#   Supabase dashboard -> Project Settings -> API -> service_role (secret)
#
# This file lives under a .gitignore that excludes .env, so the key is never
# committed. Do not move these values into workflows/n8n/*.json or .mcp.json.

SUPABASE_URL=https://exjfaggqphjkxniyshfl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
