                "a"
              ],
              "is_final_answer": false,
              "sequence_number": 1,
              "content_markdown": "$$3.12 + z \\times \\frac{\\sigma}{\\sqrt{150}} = 3.23$$",
              "guidance_markdown": "OE – correct expression. Any $$z$$, but must be a $$z$$ value.",
