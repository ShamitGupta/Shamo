      "source_page_numbers": [
        3
      ],
      "parts": [
        {
          "label_path": [
            "a"
          ],
          "prompt_markdown": "State the coordinates of $A$.",
          "marks": 1,
          "source_page_numbers": [
            3
          ]
        },
        {
          "label_path": [
            "b"
          ],
          "prompt_markdown": "A sequence of transformations is applied to the curve in the following order.\n\nTranslation of 2 units in the negative $y$-direction\n\nReflection in the $x$-axis\n\nFind the equation of the new curve and determine the coordinates of the point on the new curve corresponding to $A$.",
          "marks": 3,
          "source_page_numbers": [
            3
          ]
        }
      ],
      "mark_scheme_items": [
        {
          "sequence_number": 1,
          "mark_code": "B1",
          "content_markdown": "State $(3\\pi, -k)$",
