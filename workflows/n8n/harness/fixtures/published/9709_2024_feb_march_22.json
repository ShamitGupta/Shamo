    {
      "question_number": 3,
      "stem_markdown": "The polynomial \\(p(x)\\) is defined by\n\n\\[p(x) = 6x^3 + ax^2 + 3x - 10,\\]\n\nwhere \\(a\\) is a constant. It is given that \\((2x - 1)\\) is a factor of \\(p(x)\\).",
      "total_marks": 7,
      "source_page_numbers": [
        5
      ],
      "parts": [
        {
          "label_path": [
            "a"
          ],
          "prompt_markdown": "Find the value of \\(a\\) and hence factorise \\(p(x)\\) completely.",
          "marks": 5,
          "source_page_numbers": [
            5
          ]
        },
        {
          "label_path": [
            "b"
          ],
          "prompt_markdown": "Solve the equation \\(p(\\csc \\theta) = 0\\) for \\(-90^\\circ < \\theta < 90^\\circ\\).",
          "marks": 2,
          "source_page_numbers": [
            5
          ]
        }
      ],
      "mark_scheme_items": [
        {
          "sequence_number": 1,
          "mark_code": "M1",
          "content_markdown": "Substitute $$x = \\frac{1}{2}$$, equate to zero and attempt solution",
          "guidance_markdown": "",
          "is_final_answer": false,
          "is_alternative_method": false,
          "source_page_numbers": [
            7
          ]
        },
        {
          "sequence_number": 2,
          "mark_code": "A1",
          "content_markdown": "Obtain $$a = 31$$",
          "guidance_markdown": "",
          "is_final_answer": false,
          "is_alternative_method": false,
          "source_page_numbers": [
            7
          ]
        },
        {
          "sequence_number": 3,
          "mark_code": "M1",
          "content_markdown": "Divide by $$2x - 1$$ at least as far as $$3x^2 + mx$$",
          "guidance_markdown": "Or equivalent (for example by inspection, ...).",
          "is_final_answer": false,
          "is_alternative_method": false,
          "source_page_numbers": [
            7
          ]
        },
        {
          "sequence_number": 4,
          "mark_code": "A1",
          "content_markdown": "Obtain $$3x^2 + 17x + 10$$",
          "guidance_markdown": "",
          "is_final_answer": false,
          "is_alternative_method": false,
          "source_page_numbers": [
            7
          ]
        },
        {
          "sequence_number": 5,
          "mark_code": "A1",
          "content_markdown": "Obtain $$(2x - 1)(3x + 2)(x + 5)$$",
          "guidance_markdown": "",
          "is_final_answer": true,
          "is_alternative_method": false,
          "source_page_numbers": [
            7
          ]
        },
        {
          "sequence_number": 6,
          "mark_code": "M1",
          "content_markdown": "Attempt solution of $$\\sin \\theta = k$$ where $$k$$ is valid constant from answer to part (a)",
          "guidance_markdown": "",
          "is_final_answer": false,
