      "question_number": 1,
      "stem_markdown": "The random variable \\(X\\) takes the value \\(x\\) with probability \\(kx^2\\), where \\(k\\) is a constant and \\(x\\) takes the values \\(-2, 1, 2, 3\\) only.",
      "total_marks": 6,
      "source_page_numbers": [
        3
      ],
      "parts": [
        {
          "label_path": [
            "a"
          ],
          "prompt_markdown": "Draw up the probability distribution table for \\(X\\), giving the probabilities as numerical fractions.",
          "marks": 3,
          "source_page_numbers": [
            3
          ]
        },
        {
          "label_path": [
            "b"
          ],
          "prompt_markdown": "Find \\(E(X)\\).",
          "marks": 1,
          "source_page_numbers": [
            3
          ]
        },
        {
          "label_path": [
            "c"
          ],
          "prompt_markdown": "Find \\(P(X \\neq 2 \\mid X > 0)\\).",
